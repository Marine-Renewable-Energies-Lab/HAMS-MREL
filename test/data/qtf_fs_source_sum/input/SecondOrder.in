! qtf_indsum_half (sum frequency, half mesh) with the inner fields by the source route (qtf_fs_inner = source)
! Mean drift options of this integration test
mean_drift = 1
drift_methods = far near
motion_state = free
write_terms = 1
qtf_terms = full
qtf = 2
qtf_max_dw = 0.3
qtf_b2 = body
qtf_edge_weights = off
qtf_direct = 0
qtf_fs_inner = source
